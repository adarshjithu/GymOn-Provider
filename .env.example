# GYMON Provider Portal - Environment Variables
# For local development:
VITE_DEV_BASE_URL=http://localhost:5000/api/v1

# For Vercel production hosting:
VITE_PROD_BASE_URL=https://gymon-server.onrender.com/api/v1

# Optional: Google Maps JavaScript API key (leaves empty for default interactive map & Google Maps links)
VITE_GOOGLE_MAPS_API_KEY=
